<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Header -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⚙️ Pengaturan"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/text1"
            android:layout_marginTop="40dp" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Konfigurasi server dan koneksi"
            android:textSize="13sp"
            android:textColor="@color/text3"
            android:layout_marginBottom="20dp" />

        <!-- Server URL Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_bg"
            android:padding="20dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SERVER DASHBOARD"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:background="@color/primary"
                android:paddingHorizontal="10dp"
                android:paddingVertical="3dp"
                android:layout_marginBottom="12dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="URL dashboard web QRISGate Anda"
                android:textSize="12sp"
                android:textColor="@color/text3"
                android:layout_marginBottom="10dp" />

            <EditText
                android:id="@+id/input_server_url"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:hint="https://your-server.trycloudflare.com"
                android:textSize="13sp"
                android:inputType="textUri"
                android:background="@drawable/input_bg"
                android:paddingHorizontal="14dp"
                android:layout_marginBottom="12dp" />

            <Button
                android:id="@+id/btn_save_server"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="💾 Simpan Server URL"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:textStyle="bold"
                android:background="@color/primary"
                android:textAllCaps="false" />
        </LinearLayout>

        <!-- Login Token Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_bg"
            android:padding="20dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="API KEY / TOKEN"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:background="@color/primary"
                android:paddingHorizontal="10dp"
                android:paddingVertical="3dp"
                android:layout_marginBottom="12dp" />

            <EditText
                android:id="@+id/input_api_key"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:hint="qris_xxxxxxxxxxxx"
                android:textSize="13sp"
                android:inputType="textPassword"
                android:background="@drawable/input_bg"
                android:paddingHorizontal="14dp"
                android:layout_marginBottom="12dp" />

            <Button
                android:id="@+id/btn_save_apikey"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="💾 Simpan API Key"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:textStyle="bold"
                android:background="@color/success"
                android:textAllCaps="false" />
        </LinearLayout>

        <!-- Connection Status -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_bg"
            android:padding="20dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="STATUS KONEKSI"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:background="@color/primary"
                android:paddingHorizontal="10dp"
                android:paddingVertical="3dp"
                android:layout_marginBottom="12dp" />

            <TextView
                android:id="@+id/connection_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⏳ Belum terhubung"
                android:textSize="14sp"
                android:textColor="@color/text2"
                android:layout_marginBottom="12dp" />

            <Button
                android:id="@+id/btn_test_connection"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="🔗 Test Koneksi"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:textStyle="bold"
                android:background="@color/primary"
                android:textAllCaps="false" />
        </LinearLayout>

        <!-- App Info -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_bg"
            android:padding="20dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="QRISGate v2.0\nAndroid Native Edition\nPembaca Notifikasi + Dashboard Control"
                android:textSize="12sp"
                android:textColor="@color/text3"
                android:lineSpacingExtra="4dp"
                android:gravity="center" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="80dp" />

    </LinearLayout>
</ScrollView>
